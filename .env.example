# SENTINEL v2 — copy to .env and fill in secrets.
# NEVER commit .env to git.

# Postgres
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_STRONG_PASSWORD

# Backend
JWT_SECRET=CHANGE_ME_MIN_32_BYTES_LONG_RANDOM_STRING
LLM_API_KEY=
ADSB_URL=https://api.adsb.lol/v2/lat/40.0/lon/-75.1/dist/25
CORS_ALLOWED_ORIGIN=https://sentinel.abelprasad.dev

# Ports (host side)
BACKEND_PORT=8888
FRONTEND_PORT=3000

# Docker Hub (for CI)
DOCKERHUB_USERNAME=abelprasad
DOCKERHUB_TOKEN=

# Admin user (seeded on first boot; no registration endpoint exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<redacted>
